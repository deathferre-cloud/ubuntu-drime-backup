{
  "source": "/",
  "include_roots": [
    "/var/www",
    "/home",
    "/etc",
    "/usr/local",
    "/opt",
    "/var/spool/cron"
  ],
  "required_roots": [
    "/home",
    "/etc"
  ],
  "destination": "drime:",
  "history": "drime:.ubuntu-drime-backup/server/history",
  "metadata": "drime:.ubuntu-drime-backup/server/metadata",
  "state_dir": "/var/lib/ubuntu-drime-backup",
  "rclone": "/opt/ubuntu-drime-backup/rclone-fast",
  "network_wrapper": null,
  "rclone_config": "/etc/ubuntu-drime-backup/rclone.conf",
  "scan_interval": 300,
  "settle_seconds": 30,
  "batch_files": 512,
  "batch_bytes": 536870912,
  "transfers": 4,
  "large_file_transfers": 4,
  "large_file_threshold": 1048576,
  "tpslimit": 8,
  "night_transfers": 7,
  "night_large_file_transfers": 6,
  "night_tpslimit": 24,
  "bwlimit": "07:00,16M 19:00,off",
  "verify_sample_files": 8,
  "safety_error_limit": 5,
  "cloud_guard_workspace": 0,
  "cloud_guard_poll_seconds": 5,
  "stall_timeout_seconds": 600,
  "command_timeout_seconds": 3600,
  "connect_timeout": "20s",
  "io_timeout": "120s",
  "low_level_retries": 3,
  "cloud_guard_ordinary_extensions": [
    "exe",
    "msi",
    "msp",
    "com",
    "scr",
    "pif",
    "cpl",
    "apk",
    "dmg",
    "jar",
    "bat",
    "cmd",
    "vbs",
    "vbe",
    "js",
    "jse",
    "wsf",
    "wsh",
    "ps1",
    "psm1",
    "hta",
    "scf",
    "reg",
    "inf",
    "lnk",
    "chm",
    "dll"
  ],
  "cloud_guard_actor_email": "backup-owner@example.com",
  "cloud_guard_max_pages": 20
}
